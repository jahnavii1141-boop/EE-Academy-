# Resend — email capture
RESEND_API_KEY=

# MailerLite — subscriber sync (additive; runs alongside Resend, no-ops if unset)
# Token: MailerLite → Integrations → API → generate. Base https://connect.mailerlite.com/api
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=   # optional — group new subscribers are added to

# Clerk — authentication (Next.js)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=   # Clerk Dashboard → Webhooks → your endpoint → Signing Secret

# Paddle — payments
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_VENDOR_ID=
NEXT_PUBLIC_PADDLE_DEFAULT_URL=
NEXT_PUBLIC_PADDLE_BASIC_URL=
NEXT_PUBLIC_PADDLE_PREMIUM_URL=
NEXT_PUBLIC_PADDLE_BASIC_PRICE_ID=
NEXT_PUBLIC_PADDLE_PREMIUM_PRICE_ID=
