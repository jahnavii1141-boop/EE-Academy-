    },
    {
      "page": "/curriculum",
      "regex": "^/curriculum(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/curriculum(?:/)?$"
    },
    {
      "page": "/dashboard",
      "regex": "^/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard(?:/)?$"
    },
    {
      "page": "/dashboard/home",
      "regex": "^/dashboard/home(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/home(?:/)?$"
    },
    {
      "page": "/dashboard/modules",
      "regex": "^/dashboard/modules(?:/)?$",
